+def numerical_gradient(f, w, eps=1e-5):
+    """Central finite-difference gradient of scalar function f at w."""
+    w = np.asarray(w, dtype=float)
+    g = np.zeros_like(w)
+    for i in range(w.size):
+        e = np.zeros_like(w)
+        e[i] = eps
+        g[i] = (f(w + e) - f(w - e)) / (2 * eps)
+    return g
